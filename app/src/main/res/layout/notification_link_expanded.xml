<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_notification_panel">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/notification_thumbnail_large"
            android:layout_width="112dp"
            android:layout_height="76dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_notification_placeholder"
            android:background="@drawable/bg_notification_thumb"
            android:contentDescription="@string/notification_thumbnail" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:id="@+id/notification_source_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUTUBE"
                android:textColor="#FF5BE0F5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/notification_title_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="New link added to your queue"
                android:textColor="#FFF3F7FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/notification_state_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ACCEPTED · WAITING FOR YOUR CHOICE"
                android:textColor="#FF36D6A0"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="9dp"
        android:background="#FF26364F" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/notification_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Length · —"
            android:textColor="#FFCBD7EA"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/notification_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size · —"
            android:textColor="#FFCBD7EA"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
