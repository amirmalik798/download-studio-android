<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Queue-only cloud backup; never restore a stale SAF folder URI. -->
        <include domain="sharedpref" path="download_studio_queue.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Queue-only device transfer; the user reconnects the destination folder. -->
        <include domain="sharedpref" path="download_studio_queue.xml" />
    </device-transfer>
</data-extraction-rules>
